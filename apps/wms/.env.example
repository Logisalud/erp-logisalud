# Supabase del proyecto consolidado (mismo que cobranzas y compras).
# NUNCA pongas aquí la base de producción para pruebas: usa el modo demostración.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Modo demostración (datos de prueba en memoria, sin base real). SOLO en Preview
# (Vercel lo trae puesto) o en local con WMS_DEMO_LOCAL=1. Se rechaza en producción.
WMS_DEMO=
WMS_DEMO_LOCAL=

# Ruta del Chromium para Playwright (opcional; ver apps/wms/CLAUDE.md).
PLAYWRIGHT_CHROMIUM_PATH=
