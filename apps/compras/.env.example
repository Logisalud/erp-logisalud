# Supabase — proyecto consolidado del ERP.
# Las tablas de este módulo viven en los schemas compras, servicios, almacen,
# cuentas_x_pagar, gastos, caja_chica, financiamiento e impuestos.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor — nunca prefijar con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Autenticación (packages/auth) ---
# Ver la sección "Autenticación" del README de la raíz.
#
# Login real, sin bypass. Solo personal administrativo.
#
# No hace falta NEXT_PUBLIC_AUTH_COOKIE_DOMAIN: esta app se sirve bajo
# erp.logisalud.com/compras vía rewrite, o sea el MISMO host que cobranzas,
# así que la cookie de sesión ya se comparte sola.

# --- Correo (services/email.ts) ---
# Notificación al crear un Anticipo (Pieza 3). Mismo patrón que
# apps/pedidos/services/email.ts — proyecto de Resend propio de este
# módulo, sobre el dominio logisalud.com ya verificado (el mismo que usa
# el magic link de login).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
