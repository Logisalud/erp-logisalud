# Supabase — copiá estos valores desde:
# https://supabase.com/dashboard/project/qpkigzniatidsvnxikox/settings/api

# URL del proyecto (pestaña "Project URL")
NEXT_PUBLIC_SUPABASE_URL=https://qpkigzniatidsvnxikox.supabase.co

# Anon/public key (pestaña "Project API keys" → anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key (pestaña "Project API keys" → service_role) — NUNCA la expongas al cliente
SUPABASE_SERVICE_ROLE_KEY=

# --- Autenticación (packages/auth) ---
# Ver la sección "Autenticación" del README de la raíz.
#
# El login es real desde el día uno: no hay variable de bypass ni modo de
# prueba. Aplica solo al personal administrativo — los vendedores entran por
# su link con token y no pasan por acá.

# Opcional. Dominio de la cookie de sesión, para compartir el login entre apps.
# Solo funciona con un dominio propio (ej. .logisalud.com), no con *.vercel.app.
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=
